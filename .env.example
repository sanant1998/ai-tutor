# Supabase — Project settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role. Required by the tutor and by nothing else.
#
# It bypasses row-level security, which is exactly why it is needed: the
# question bank's answers are readable by no signed-in user at all, and the
# server has to read them to mark an attempt and to check that the tutor did
# not give one away. Server-side only — it must never reach a browser, so it
# has no NEXT_PUBLIC_ prefix and never will.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Model provider
#
# Questions, marking, notes, mock papers and exam-FAQ answers all run through
# one function, so the provider is an env choice. Pick ONE recipe below.
# Without a key the app still runs; the AI routes return a clear 503.
# ---------------------------------------------------------------------------

AI_PROVIDER=anthropic
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=

# --- Anthropic (Claude) ----------------------------------------------------
# Best marking quality. Paid from the first call.
#   AI_PROVIDER=anthropic
#   AI_API_KEY=sk-ant-...
#   AI_MODEL=claude-sonnet-5
#   AI_BASE_URL=

# --- Google Gemini ---------------------------------------------------------
# Has a genuinely free tier with daily limits — the cheapest way to start.
#   AI_PROVIDER=openai
#   AI_API_KEY=<AI Studio key>
#   AI_MODEL=gemini-2.5-flash
#   AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# --- OpenRouter ------------------------------------------------------------
# One key, most models, switch by changing AI_MODEL alone.
#   AI_PROVIDER=openai
#   AI_API_KEY=sk-or-...
#   AI_MODEL=anthropic/claude-sonnet-4.5
#   AI_BASE_URL=https://openrouter.ai/api/v1

# --- Groq ------------------------------------------------------------------
# Free tier, very fast, open-weight models. Marking is weaker than Claude.
#   AI_PROVIDER=openai
#   AI_API_KEY=gsk_...
#   AI_MODEL=llama-3.3-70b-versatile
#   AI_BASE_URL=https://api.groq.com/openai/v1

# --- OpenAI ----------------------------------------------------------------
#   AI_PROVIDER=openai
#   AI_API_KEY=sk-...
#   AI_MODEL=gpt-4o-mini
#   AI_BASE_URL=

# --- The tutor's two tiers ---------------------------------------------------
# Teaching and checking use the strong model; summaries, classification and
# marking use the fast one. That split is most of the bill and none of the
# experience — a student cannot tell which model wrote a three-bullet summary
# and can absolutely tell which one taught them.
#
# Both default to AI_MODEL when unset.
AI_MODEL_STRONG=
AI_MODEL_FAST=

# --- Fallback provider -------------------------------------------------------
# Takes over when the primary errors, or produces nothing within
# AI_FIRST_TOKEN_TIMEOUT_MS. Only ever swapped in before the first token has
# reached the student — switching mid-sentence reads worse than a clean error.
#
# Worth setting to a DIFFERENT vendor, not another model at the same one: the
# outage this protects against is usually the vendor's.
#
# The eval harness also uses it as the judge, so a model does not grade its own
# teaching. Without it the judged scores run about half a point high.
AI_FALLBACK_PROVIDER=
AI_FALLBACK_API_KEY=
AI_FALLBACK_MODEL=
AI_FALLBACK_BASE_URL=

# How long the primary may stay silent before the fallback takes over. Not a
# total timeout — a long answer is fine — a first-token one, because silence is
# the only symptom a student can see.
AI_FIRST_TOKEN_TIMEOUT_MS=6000

# --- Unit economics ----------------------------------------------------------
# INR per million tokens, used to price every llm_calls row. Leave blank to use
# the built-in estimates in lib/ai/stream.ts; set these once a real rate card
# is known, because cost-per-taught-concept is the number that decides whether
# the subscription price works.
AI_RATE_IN=
AI_RATE_OUT=

# --- Optional per-feature overrides -----------------------------------------
# Diagram geometry is the hardest call in the app. Leave blank to use AI_MODEL;
# set a stronger model here if diagrams come out inconsistent.
AI_MODEL_DIAGRAMS=

# Narration voice. OpenAI-compatible speech endpoint (/audio/speech).
AI_TTS_MODEL=tts-1
AI_TTS_VOICE=alloy

# Deprecated spelling, still read so an existing deployment keeps working.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=

# ===========================================================================
# Consent, messaging, payments, schools
# ===========================================================================

# Where the consent link points. Without it the link is built from the request
# origin, which is wrong behind a proxy and wrong in a cron job.
NEXT_PUBLIC_SITE_URL=

# --- Grievance officer ------------------------------------------------------
# Publishing a contact is a statutory requirement under the DPDP Act, not a
# nicety. The consent screen says so in amber when these are unset, which is
# deliberate — it should be visible in review rather than in a regulator's
# letter.
NEXT_PUBLIC_GRIEVANCE_OFFICER_NAME=
NEXT_PUBLIC_GRIEVANCE_OFFICER_EMAIL=

# --- WhatsApp (Meta Cloud API) ----------------------------------------------
# Indian parents read WhatsApp and do not read email. A utility template costs
# about ₹0.12; at one weekly report per student that is under ₹7 a year and is
# the single highest-leverage rupee in the business.
#
# Templates must be APPROVED in the Meta console before they deliver. The four
# this app uses are named in lib/messaging/send.ts — a template referenced in
# code and not approved in the console is how this integration "works in
# staging" and silently fails in production.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=

# --- SMS fallback -----------------------------------------------------------
# Only used for the parental-consent code, because a parent who cannot receive
# it cannot consent and their child cannot use the app. DLT registration is
# mandatory for transactional SMS in India; the template id comes from the
# operator.
SMS_ENDPOINT=
SMS_API_KEY=
SMS_SENDER_ID=
SMS_DLT_TEMPLATE_ID=

# --- Razorpay ---------------------------------------------------------------
# UPI Autopay is the rail that actually renews in this market. Create the plans
# ONCE (scripts/razorpay-setup.ts) and put the ids here — creating one per
# checkout works and quietly fills the dashboard with thousands of duplicates.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PLAN_MONTHLY=
RAZORPAY_PLAN_ANNUAL=

# --- Scheduled work ---------------------------------------------------------
# The parent-report cron authorises on this. Unset means the endpoint refuses
# to run at all: an unprotected route that spends money on messages is worse
# than one that never fires.
CRON_SECRET=

# --- Content console --------------------------------------------------------
# Comma-separated addresses allowed to publish curriculum. An env allowlist
# rather than a database flag, because a role column is one bad UPDATE away
# from letting something change what every student is taught. Empty means
# nobody, not everybody.
ADMIN_EMAILS=

# --- Symbolic maths ---------------------------------------------------------
# services/math-verify. Optional: without it the tutor still checks rational
# arithmetic exactly (lib/math/verify.ts) and stays silent on algebra, which
# covers nearly all of Class 8. Needed for Class 9-10 factorisation and roots.
MATH_VERIFY_URL=
MATH_VERIFY_TIMEOUT_MS=2500

# --- Speech to text ---------------------------------------------------------
# Voice is a phase-2 feature and a premium one — the cost and the latency are
# both heavy.
#
# Do NOT default to Whisper. Its word error rate on Indian-accented English is
# substantially worse than models trained on Indic speech, and worse again on
# the Hinglish code-switching these students actually speak. A tutor that
# mishears the question and confidently answers a different one is worse than
# no voice feature. Prefer Sarvam or Google Chirp Indic.
STT_URL=
STT_API_KEY=
STT_MODEL=
STT_LANGUAGE=en

# --- Company details, for the legal pages ------------------------------------
# A privacy policy that names no controller is not a policy. The pages show an
# amber "not ready to publish" banner until these are set.
NEXT_PUBLIC_LEGAL_NAME=
NEXT_PUBLIC_LEGAL_ADDRESS=
NEXT_PUBLIC_GSTIN=
NEXT_PUBLIC_SUPPORT_EMAIL=

# --- Analytics ---------------------------------------------------------------
# A plain JSON POST per event: {event, properties, at}. Every analytics product
# accepts this natively or behind a one-line proxy — deliberately not an SDK,
# which would mean a dependency, a client script and, with most vendors,
# third-party cookies on a page used by children.
#
# Unset means events go to the console in development and nowhere in
# production. That is a real gap: an app that cannot tell it is broken is
# broken. The four numbers with alerts behind them are named in the README.
NEXT_PUBLIC_ANALYTICS_URL=

# --- Teaching language --------------------------------------------------------
# Not an env var — it is per student, on profiles.language, and chosen from the
# picker on /tutor. Three options: hinglish (default), hi-IN, en-IN.
#
# Noted here only because the field existed and did nothing for a long time:
# it was read into the prompt as a bare string that no instruction acted on, so
# a student set to hi-IN got Hinglish like everyone else. See lib/language.ts.

# --- Tutor speech ------------------------------------------------------------
# A speaker button on each tutor message. On demand, never automatic: speaking
# every reply multiplies the per-student cost, adds seconds to a turn the
# student is already waiting on, and most replies are three lines they read
# faster than a voice can say them.
#
# Billed per character, so the mp3 is cached on a hash of the SPOKEN text —
# two students hearing the same worked example pay once between them, because
# the tutor teaches from a fixed content pack and its sentences repeat.
#
# OpenAI-compatible /audio/speech. Falls back to AI_API_KEY when no separate
# key is set.
AI_TTS_URL=
AI_TTS_API_KEY=
# AI_TTS_MODEL and AI_TTS_VOICE are set further up.

# --- Error reports -----------------------------------------------------------
# A plain JSON POST per error. Unset means they go to the error_reports table
# instead, which is the point — before this, every failure path called
# console.error and stopped, and the first sign a route was 500ing was a
# student closing the tab.
ERROR_REPORT_URL=
